def validate_input_data(data: InputData) -> None:
    """
    Validate input data before analysis.
    
    Args:
        data: Input data to validate
        
    Raises:
        ValueError: If data is invalid
    """
    if not data.data_points:
        raise ValueError("No data points provided")
    
    if len(data.data_points) < 2:
        raise ValueError("At least 2 data points required for analysis")
    
    # Check for NaN or infinite values
    for i, point in enumerate(data.data_points):
        if not np.isfinite(point.x):
            raise ValueError(f"Invalid x value at index {i}: {point.x}")
        if not np.isfinite(point.y):
            raise ValueError(f"Invalid y value at index {i}: {point.y}")
        if point.error is not None and not np.isfinite(point.error):
            raise ValueError(f"Invalid error value at index {i}: {point.error}")
    
    logger.debug(f"Input data validated: {len(data.data_points)} points")


